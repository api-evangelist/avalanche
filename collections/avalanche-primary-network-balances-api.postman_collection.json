      "id": "de49e14f-4805-4c16-aa4b-b5c2d067ef32",
      "name": "Primary Network Balances",
      "description": {
        "content": "Find information about balances on Avalanche's Primary Network Chains - the P-Chain, the X-Chain, and the C-Chain.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "3e58d547-9960-41e2-8a77-76f65d164737",
          "name": "Get balances",
          "request": {
            "name": "Get balances",
            "description": {
              "content": "Gets primary network balances for one of the Primary Network chains for the supplied addresses.\n\nC-Chain balances returned are only the shared atomic memory balance. For EVM balance, use the `/v1/chains/:chainId/addresses/:addressId/balances:getNative` endpoint.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "networks",
                ":network",
                "blockchains",
                ":blockchainId",
                "balances"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "blockTimestamp",
                  "value": "<integer>",
                  "description": "An epoch timestamp in seconds. Balance will be calculated at this timestamp."
                },
                {
                  "disabled": false,
                  "key": "addresses",
                  "value": "<string>",
                  "description": "A comma separated list of X-Chain or P-Chain wallet addresses, starting with \"avax\"/\"fuji\", \"P-avax\"/\"P-fuji\" or \"X-avax\"/\"X-fuji\"."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "blockchainId",
                  "description": "(Required) A primary network blockchain id or alias."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "network",
                  "description": "(Required) Either mainnet or testnet/fuji."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
